{
  "manifest_version": 3,
  "name": "AI 自动阅卷助手",
  "version": "0.1.0",
  "description": "基于 OCR 与 AI 的 Chrome 自动阅卷插件。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 自动阅卷助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yue.haofenshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
